# OpenAI API Configuration (optional - if you want to use GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Configuration (optional - if you want to use local Ollama models)
OLLAMA_BASE_URL=http://localhost:11434

# Application Configuration
LOG_LEVEL=INFO

# Notes:
# - If no OpenAI API key is provided, the app will use a local fallback model
# - The app will work without any API keys using built-in knowledge and local models
# - Copy this file to .env and fill in your actual values